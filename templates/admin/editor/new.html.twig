{% extends 'base.html.twig' %}

{% block title %}Ajout d'un éditeur{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 4em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        <h1>Ajout d'un éditeur</h1>
        {{ form_start(form) }}
            {{ form_row(form.name, {label: 'nom'}) }}
            <button type="submit" class="btn btn-primary">Envoyer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}