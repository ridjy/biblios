{% extends 'base.html.twig' %}

{% block title %}Ajout d'un livre{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 4em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        <h1>Ajout d'un livre</h1>
        {{ form_start(form) }}
            {{ form_row(form.title, {label: 'Titre'}) }}
            {{ form_row(form.editedAt, {label: 'Date d\'edition'}) }}
            {{ form_row(form.plot, {label: 'Synopsis'}) }}
            {{ form_row(form.cover, {label: 'Couverture'}) }}
            {{ form_row(form.pageNumber, {label: 'Nombre de page'}) }}
            {{ form_row(form.status, {label: 'Statut'}) }}
            {{ form_row(form.editor, {label: 'Editor'}) }}
            {{ form_row(form.author, {label: 'Auteur'}) }}
            {{ form_row(form._token) }}
            <button type="submit" class="btn btn-primary">Envoyer</button>
        {{ form_end(form, { render_rest: false }) }}
    </div>
{% endblock %}